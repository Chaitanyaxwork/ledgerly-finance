# Copy this file to .env for local overrides (optional — sensible defaults
# are used if these are unset). In production (Render, etc.) set these as
# real environment variables in the platform's dashboard instead of a file.

# Defaults to a local SQLite file if unset. For production, use a hosted
# PostgreSQL URL (Render/Neon/Supabase all provide one directly), e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# REQUIRED in production. Signs login tokens: anyone who knows it can forge a
# login for any account. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Locally you can leave it blank (a git-ignored key file is created for you),
# but that shortcut is refused when DATABASE_URL points at a real database.
SECRET_KEY=

# How long a login lasts, in minutes (default 10080 = 7 days).
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:8000
# Leave blank for local development (defaults to allowing all origins).
CORS_ORIGINS=
